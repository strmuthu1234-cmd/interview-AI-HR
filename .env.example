# ============================================================================
# AI HR Recruitment & Interview System - environment configuration
# Copy to .env (never commit .env). All secrets come from the environment.
# ============================================================================

# ---- Django -----------------------------------------------------------------
DJANGO_DEBUG=false
# Required when DJANGO_DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=hr.example.com
# Public URL of the frontend (used in candidate interview links and CORS)
FRONTEND_URL=https://hr.example.com
CORS_ALLOWED_ORIGINS=https://hr.example.com
CSRF_TRUSTED_ORIGINS=https://hr.example.com
# Set to false only if TLS is terminated and redirected by a proxy you control
SECURE_SSL_REDIRECT=true
TIME_ZONE=UTC
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL=postgres://hrai:change-me@db:5432/hrai
POSTGRES_DB=hrai
POSTGRES_USER=hrai
POSTGRES_PASSWORD=change-me

# ---- Celery / Redis ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# true = run background jobs synchronously (local dev without Redis only)
CELERY_TASK_ALWAYS_EAGER=false

# ---- JWT ---------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# ---- AI provider (leave empty to run without AI) ---------------------------
# openai | anthropic | mock   ("mock" = clearly labelled testing mode, NOT a real assessment)
# Can also be chosen per organisation under Settings -> AI provider.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_REQUEST_TIMEOUT=90
# Optional server-side speech-to-text (OpenAI). Browser speech-to-text needs no key.
OPENAI_STT_MODEL=whisper-1

# ---- Resume OCR fallback for scanned PDFs (needs Tesseract installed) --------
OCR_ENABLED=false

# ---- File storage -------------------------------------------------------------
MEDIA_ROOT=/app/media
MAX_RESUME_FILE_MB=5
MAX_AUDIO_FILE_MB=25
# S3-compatible storage (AWS S3, MinIO, Cloudflare R2 ...). false = local disk.
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Email (interview invitations) ------------------------------------------
# Dev default prints emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=hiring@example.com

# ---- Rate limits (DRF format) -----------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_CANDIDATE=120/min
THROTTLE_UPLOAD=30/hour

# ---- Demo seed only (python manage.py seed_demo) ------------------------------
DEMO_ADMIN_PASSWORD=
DEMO_HR_PASSWORD=
